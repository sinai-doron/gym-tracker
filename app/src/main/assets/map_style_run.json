{
  "version": 8,
  "name": "Gym Tracker — run",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> © <a href=\"https://www.openmaptiles.org/\">OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#F0EEFF" }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "wood", "farmland"]]],
      "paint": { "fill-color": "#DCF1E4", "fill-opacity": 0.8 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#D3EEDD" }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["cemetery", "pitch", "playground", "grass", "garden"]]],
      "paint": { "fill-color": "#DCF1E4" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#CFE4FA" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#CFE4FA",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 18, 6]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-color": "#E6E2FA",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 15, 0, 16, 0.7]
      }
    },
    {
      "id": "path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["in", ["get", "class"], ["literal", ["path", "track"]]],
      "layout": { "line-cap": "round" },
      "paint": {
        "line-color": "#C9C1F2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1, 18, 2.5],
        "line-dasharray": [1.5, 1.5]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#DDD8F6",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 3, ["secondary", "tertiary"], 2, 1],
          18, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 28, ["secondary", "tertiary"], 24, "service", 10, 18]
        ]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 2, ["secondary", "tertiary"], 1.2, 0.5],
          18, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 24, ["secondary", "tertiary"], 20, "service", 7, 15]
        ]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 18, 13]
      },
      "paint": {
        "text-color": "#8A82A3",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "any",
        ["all", ["<", ["zoom"], 13], ["in", ["get", "class"], ["literal", ["city", "town", "village"]]]],
        ["all", [">=", ["zoom"], 13], ["<", ["zoom"], 15.5], ["in", ["get", "class"], ["literal", ["suburb", "neighbourhood"]]]]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["match", ["get", "class"], ["city", "town"], 15, 12],
        "text-transform": "none"
      },
      "paint": {
        "text-color": "#6B6280",
        "text-halo-color": "#F0EEFF",
        "text-halo-width": 2
      }
    }
  ]
}
