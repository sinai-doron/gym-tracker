    <!-- Account and sync -->
    <string name="onboarding_account_title">גיבוי בשרת (רשות)</string>
    <string name="onboarding_account_text">התחברות עם Google שומרת עותק של האימונים בשרת, לגיבוי ולטלפון נוסף. אפשר לדלג ולהתחבר אחר כך בהגדרות.</string>
    <string name="account_title">חשבון</string>
    <string name="account_signed_out_text">ההתחברות היא רשות. בלעדיה האפליקציה עובדת כרגיל והכל נשאר בטלפון. אחרי התחברות אפשר לגבות ולסנכרן את האימונים לשרת.</string>
    <string name="account_sign_in">התחברות עם Google</string>
    <string name="account_sign_out">התנתקות</string>
    <string name="account_routes_hint">כיבוי מוחק את המסלולים מהשרת. הם נשארים בטלפון.</string>
    <string name="account_sign_in_failed">ההתחברות לא הצליחה. כדאי לבדוק את החיבור לאינטרנט ולנסות שוב.</string>
    <string name="account_not_allowed">החשבון הזה עדיין לא מורשה להתחבר.</string>
    <string name="consent_title">לפני שמתחברים</string>
    <string name="consent_intro">אחרי ההתחברות האפליקציה תשמור עותק של הנתונים שלך בשרת, כדי לגבות אותם ולאפשר שימוש בהם גם בטלפון אחר.</string>
    <string name="consent_synced_title">מה יסונכרן</string>
    <string name="consent_synced">תוכנית האימונים, אימונים וסטים, וריצות והליכות: מרחק, זמן, קצב, הקפות, טיפוס וקלוריות.</string>
    <string name="consent_never_title">מה לא יסונכרן אף פעם</string>
    <string name="consent_never">נתונים מ-Health Connect (צעדים ודופק).</string>
    <string name="consent_why_title">למה</string>
    <string name="consent_why">גיבוי, ושימוש באותם נתונים בטלפון חדש או נוסף.</string>
    <string name="consent_who_title">מי רואה</string>
    <string name="consent_who">רק את/ה. הנתונים נשמרים בשרת של neonsheep, נפרדים מהנתונים של כל משתמש אחר.</string>
    <string name="consent_stop_title">איך מפסיקים</string>
    <string name="consent_stop">התנתקות עוצרת את הסנכרון. אפשר גם למחוק את כל הנתונים מהשרת, והם נשארים בטלפון.</string>
    <string name="consent_routes_title">גם מסלולי ריצה (GPS)</string>
    <string name="consent_routes_text">מסלול מראה איפה רצת או הלכת ומתי. בלעדיו ריצות מסונכרנות בלי המסלול. אפשר לשנות בהגדרות.</string>
    <string name="consent_agree">מסכים/ה, להתחברות</string>
    <string name="consent_not_now">לא עכשיו</string>
    <string name="account_sync_now">סנכרון עכשיו</string>
    <string name="account_synced_at">סונכרן %1$s</string>
    <string name="account_sync_never">עוד לא סונכרן</string>
    <string name="account_sync_pending">הסנכרון ממתין (אין חיבור?)</string>
    <string name="account_sync_pending_since">סונכרן %1$s · הסנכרון האחרון ממתין</string>
    <string name="consent_music_title">גם רשימת השירים</string>
    <string name="consent_music_text">אילו שירים התנגנו בכל אימון ומתי, מסרגל הניגון. בלעדיה האימונים מסונכרנים בלי השירים. אפשר לשנות בהגדרות.</string>
    <string name="account_music_hint">כיבוי מוחק את רשימת השירים מהשרת. היא נשארת בטלפון.</string>
    <string name="account_delete_server_data">מחיקת הנתונים מהשרת</string>
    <string name="account_delete_confirm_text">כל מה שסונכרן יימחק מהשרת, ואז תתבצע התנתקות. האימונים בטלפון נשארים.</string>
    <string name="account_delete_confirm">מחיקה</string>
    <string name="account_delete_failed">המחיקה לא הצליחה, לא נמחק כלום. כדאי לבדוק את החיבור ולנסות שוב.</string>
    <string name="account_other_owner">האימונים בטלפון הזה שייכים לחשבון %1$s. אפשר להתחבר רק עם החשבון הזה. כדי להשתמש בחשבון אחר, צריך קודם למחוק את נתוני האפליקציה בטלפון.</string>
