    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Hey there! 👋</string>
    <string name="onboarding_welcome_text">Glad you\'re here! I\'ll count your sets, runs and steps. A few quick permissions and we\'re off.</string>
    <string name="onboarding_lets_go">Let\'s go</string>
    <string name="onboarding_notifications_title">Ding! Next set</string>
    <string name="onboarding_notifications_text">Notifications let me show your rest timer and your run on the lock screen, so you don\'t have to unlock your phone mid-workout.</string>
    <string name="onboarding_notifications_button">Turn on notifications</string>
    <string name="onboarding_activity_title">Every step counts</string>
    <string name="onboarding_activity_text">Physical activity access lets me count your steps with the phone\'s sensor and show how close you are to your daily goal.</string>
    <string name="onboarding_activity_button">Allow step counting</string>
    <string name="onboarding_location_title">Where are we running?</string>
    <string name="onboarding_location_text">Precise location lets me draw your route, measure distance and pace, and show today\'s weather.</string>
    <string name="onboarding_location_button">Allow location</string>
    <string name="onboarding_health_title">Heart of a champion</string>
    <string name="onboarding_health_text">Connecting Health Connect saves your workouts and runs, reads all-day steps and your watch\'s heart rate.</string>
    <string name="onboarding_health_button">Connect Health Connect</string>
    <string name="onboarding_music_title">Music is half the workout</string>
    <string name="onboarding_music_text">Notification access lets me show what\'s playing and skip or pause without leaving the app. In the screen that opens, turn on Workout Tracker.</string>
    <string name="onboarding_music_button">Open settings</string>
    <string name="onboarding_ready_title">Ready to move!</string>
    <string name="onboarding_ready_text">All set. You can change permissions any time from Settings.</string>
    <string name="onboarding_start">Let\'s train</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_enabled">Enabled ✓</string>
    <string name="permissions">Permissions</string>
    <string name="permissions_review">Review permissions</string>

    <!-- Account and sync -->
    <string name="onboarding_account_title">Back up to the server (optional)</string>
    <string name="onboarding_account_text">Signing in with Google keeps a copy of your workouts on the server, as a backup and for another phone. You can skip this and sign in later in Settings.</string>
    <string name="account_title">Account</string>
    <string name="account_signed_out_text">Signing in is optional. Without it the app works as usual and everything stays on this phone. Signed in, you can back up and sync your workouts to the server.</string>
    <string name="account_sign_in">Sign in with Google</string>
    <string name="account_sign_out">Sign out</string>
    <string name="account_routes_hint">Turning this off deletes your routes from the server. They stay on this phone.</string>
    <string name="account_sign_in_failed">Sign-in didn\'t work. Check your internet connection and try again.</string>
    <string name="account_not_allowed">This account isn\'t allowed to sign in yet.</string>
    <string name="consent_title">Before you sign in</string>
    <string name="consent_intro">Once you sign in, the app keeps a copy of your data on the server, as a backup and so you can use it on another phone.</string>
    <string name="consent_synced_title">What syncs</string>
    <string name="consent_synced">Your training plan, workouts and sets, and runs and walks: distance, time, pace, laps, climb and calories.</string>
    <string name="consent_never_title">What never syncs</string>
    <string name="consent_never">Data from Health Connect (steps and heart rate).</string>
    <string name="consent_why_title">Why</string>
    <string name="consent_why">A backup, and the same data on a new or second phone.</string>
    <string name="consent_who_title">Who sees it</string>
    <string name="consent_who">Only you. It is kept on neonsheep\'s server, apart from every other user\'s data.</string>
    <string name="consent_stop_title">How to stop</string>
    <string name="consent_stop">Signing out stops syncing. You can also delete everything from the server; it stays on this phone.</string>
    <string name="consent_routes_title">Run routes too (GPS)</string>
    <string name="consent_routes_text">A route shows where and when you ran or walked. Without it, runs sync without their route. You can change this in Settings.</string>
    <string name="consent_agree">I agree, sign in</string>
    <string name="consent_not_now">Not now</string>
    <string name="account_sync_now">Sync now</string>
    <string name="account_synced_at">Synced %1$s</string>
    <string name="account_sync_never">Not synced yet</string>
    <string name="account_sync_pending">Sync is waiting (offline?)</string>
    <string name="account_sync_pending_since">Synced %1$s · the latest sync is waiting</string>
    <string name="consent_music_title">Your music too</string>
    <string name="consent_music_text">Which songs played during each workout, and when, from the now-playing bar. Without it, workouts sync without their songs. You can change this in Settings.</string>
    <string name="account_music_hint">Turning this off deletes your music list from the server. It stays on this phone.</string>
    <string name="account_delete_server_data">Delete my data from the server</string>
    <string name="account_delete_confirm_text">Everything synced is deleted from the server, then you are signed out. The workouts on this phone stay.</string>
    <string name="account_delete_confirm">Delete</string>
    <string name="account_delete_failed">Couldn\'t delete; nothing was deleted. Check your connection and try again.</string>
    <string name="account_other_owner">The workouts on this phone belong to %1$s. Only that account can sign in here. To use another account, clear the app\'s data on this phone first.</string>
